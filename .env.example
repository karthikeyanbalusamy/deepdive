# Mesh API key (mandatory: every LLM call goes through Mesh). Starts with rsk_
MESH_API_KEY=rsk_...

# Web search (https://tavily.com)
TAVILY_API_KEY=tvly-...

# Optional: Mesh model ids. A different verifier model means claims are not checked by their author.
# MODEL=openai/gpt-4o-mini
# VERIFIER_MODEL=google/gemini-2.5-flash
# JUDGE_MODEL=anthropic/claude-haiku-4.5
